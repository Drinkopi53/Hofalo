// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  KETUA
  STAFF
  JEMAAT
}

enum TransactionType {
  PEMASUKAN
  PENGELUARAN
}

enum OfferingType {
  PERSEPULUHAN
  PERSEMBAHAN_UMUM
  PERSEMBAHAN_SYUKUR
  PERSEMBAHAN_KHUSUS
  LAINNYA
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String
  role          Role      @default(JEMAAT)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  createdTransactions Transaction[] @relation("CreatedBy")
  createdOfferings    Offering[]     @relation("OfferingCreatedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Congregation {
  id        String   @id @default(cuid())
  name      String
  nik       String?  @unique
  address   String?
  phone     String?
  birthDate DateTime?
  gender    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  offerings Offering[]
}

model Category {
  id          String        @id @default(cuid())
  name        String        @unique
  type        TransactionType
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  amount      Float
  description String
  date        DateTime        @default(now())
  notes       String?
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id])
  createdById String
  createdBy   User            @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Offering {
  id             String       @id @default(cuid())
  type           OfferingType
  amount         Float
  date           DateTime     @default(now())
  congregationId String?
  congregation   Congregation? @relation(fields: [congregationId], references: [id])
  notes          String?
  createdById    String
  createdBy      User         @relation("OfferingCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Budget {
  id          String   @id @default(cuid())
  year        Int
  month       Int?
  category    String
  amount      Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([year, month, category])
}

model CashBalance {
  id        String   @id @default(cuid())
  date      DateTime @unique @default(now())
  balance   Float
  notes     String?
  updatedAt DateTime @updatedAt
}
